# Copy to .env and fill in. NEVER commit the real .env file.

# Optional: enables LLM-written answers (Claude) in the Knowledge Brain.
# Without it the Brain runs in deterministic "extractive" mode (still cited).
ANTHROPIC_API_KEY=
# Model used when ANTHROPIC_API_KEY is set (untested in this repo - verify the name in your account)
BRAIN_LLM_MODEL=claude-sonnet-4-5

# Where Task 2 / Task 3 find the Knowledge Brain API
BRAIN_API_URL=http://127.0.0.1:8000

# Docs source: auto (try live site, then cache, then local fallback) | live | fallback
BRAIN_SOURCE=auto
BRAIN_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
BRAIN_MAX_PAGES=300

# Task 3 pricing assumptions (placeholders - set your real rate)
SOW_HOURLY_RATE=95
